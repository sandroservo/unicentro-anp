# Database - Postgres (suba com: docker compose up -d)
DATABASE_URL="postgresql://anp:anp@localhost:5433/anp?schema=public"

# Auth.js v5 (gere uma chave forte: `openssl rand -base64 32`)
AUTH_SECRET="sua-chave-secreta-super-segura-aqui-123456"
NEXTAUTH_SECRET="sua-chave-secreta-super-segura-aqui-123456"
NEXTAUTH_URL="http://localhost:3001"

# Professor Virtual (IA) - use qualquer provedor configurando uma chave abaixo
# AI_PROVIDER: "anthropic" | "openai" (opcional; se omitido, usa o primeiro com chave)
AI_PROVIDER=anthropic

# Anthropic (Claude) - https://console.anthropic.com
ANTHROPIC_API_KEY=""
# AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (GPT) - https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# AI_OPENAI_MODEL=gpt-4o-mini

# Motor do tutor/correção IA (chat via gateway OpenAI-compatible)
# OmniRoute (gateway self-hosted, 291+ provedores + fallback) - https://github.com/diegosouzapw/OmniRoute
#   Rode: npm i -g omniroute  ->  localhost:20128 ; pegue o token no dashboard.
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=""
# OMNIROUTE_MODEL=auto            # "auto" = OmniRoute roteia sozinho (default quando OMNIROUTE_* setado)
#   Para usar SÓ IA grátis: no dashboard do OmniRoute selecione a estratégia
#   "Free" (ou "cost-optimized") — ele tenta os 90+ provedores de free tier e faz fallback.
# Fallback OpenRouter público (se OMNIROUTE_* não setado):
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL=openai/gpt-4o-mini

# YouTube API (opcional - para metadados dos vídeos)
YOUTUBE_API_KEY=""
