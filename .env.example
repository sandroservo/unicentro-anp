# Database - Postgres (suba com: docker compose up -d)
DATABASE_URL="postgresql://anp:anp@localhost:5433/anp?schema=public"

# Auth.js v5 (gere uma chave forte: `openssl rand -base64 32`)
AUTH_SECRET="sua-chave-secreta-super-segura-aqui-123456"
NEXTAUTH_SECRET="sua-chave-secreta-super-segura-aqui-123456"
NEXTAUTH_URL="http://localhost:3001"

# Motor do Professor IA / correção — OmniRoute (gateway OpenAI-compatible)
# https://github.com/diegosouzapw/OmniRoute
#   Local:  npm i -g omniroute && omniroute serve
#   Dashboard: http://localhost:20128  ·  API: http://localhost:20128/v1
#   Estratégia Free no dashboard = prioriza provedores de free tier.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# OMNIROUTE_API_KEY=""            # token do dashboard (opcional se REQUIRE_API_KEY=false)
OMNIROUTE_MODEL=auto

# Fallback OpenRouter público (só se OmniRoute não estiver configurado):
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL=openai/gpt-4o-mini

# YouTube API (opcional - para metadados dos vídeos)
YOUTUBE_API_KEY=""
