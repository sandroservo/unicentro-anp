// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums como strings (mantido do SQLite; sem enums nativos por ora)
// UserRole: STUDENT, MONITOR, TEACHER, ADMIN, SUPER
// ActivityType: QUIZ, ESSAY, FILE_UPLOAD, FORUM

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  avatar        String?
  role          String    @default("STUDENT") // TRANSITÓRIO — dropar no fim da Phase 1 (usar roleRel)
  roleId        String?
  roleRel       Role?     @relation(fields: [roleId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments          Enrollment[]
  subjectEnrollments   SubjectEnrollment[]
  forumPosts           ForumPost[]
  submissions          Submission[]
  aiChats              AIChat[]
  progress             Progress[]
  studentProfile       StudentProfile?
  coordinatedCourses   Course[] @relation("CourseCoordinator")
  certificates         Certificate[]
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matricula String   @unique
  cpf       String?  @unique
  phone     String?
  status    String   @default("ATIVO") // ATIVO | INATIVO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  slug        String           @unique // SUPER_ADMIN, ADMINISTRADOR, COORDENADOR, TUTOR, PROFESSOR, ALUNO
  name        String
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique // ex: students.read, courses.write
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Course {
  id            String    @id @default(cuid())
  title         String
  description   String
  thumbnail     String?
  isActive      Boolean   @default(true)
  slug          String?   @unique // gerado do título (estável)
  code          String?   // código institucional
  workloadHours Int?      // carga horária
  coordinatorId String?
  coordinator   User?     @relation("CourseCoordinator", fields: [coordinatorId], references: [id])
  aiPersona     String?   // Persona do Professor Virtual
  aiContext     String?   // Contexto/Ementa para a IA
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  modules       Module[]
  subjects      Subject[]
  enrollments   Enrollment[]
  certificates  Certificate[]
}

model Enrollment {
  id            String    @id @default(cuid())
  userId        String
  courseId      String
  role          String    @default("STUDENT")
  progress      Float     @default(0)
  enrolledAt    DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

/// Vínculo aluno ↔ matéria (Subject). Só quem está aqui assiste aulas e vê notas da matéria.
model SubjectEnrollment {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String
  enrolledAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

model Module {
  id            String    @id @default(cuid())
  courseId      String
  subjectId     String?
  title         String
  description   String?
  order         Int

  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject       Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessons       Lesson[]
}

model Subject {
  id         String   @id @default(cuid())
  courseId   String
  title      String
  code       String?
  order      Int      @default(0)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modules    Module[]
  enrollments SubjectEnrollment[]
}

model Lesson {
  id            String    @id @default(cuid())
  moduleId      String
  title         String
  description   String?
  videoUrl      String?   // URL do YouTube
  videoId       String?   // ID do vídeo YouTube
  transcript    String?   // Transcrição para contexto da IA
  duration      Int?      // Duração em segundos
  order         Int

  module        Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials     Material[]
  activities    Activity[]
  forumPosts    ForumPost[]
  aiChats       AIChat[]
  progress      Progress[]
}

model Material {
  id            String    @id @default(cuid())
  lessonId      String
  title         String
  type          String    // pdf, doc, link, etc
  url           String
  content       String?   // Conteúdo extraído para IA
  order         Int

  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Activity {
  id            String    @id @default(cuid())
  lessonId      String
  title         String
  description   String?
  type          String    // QUIZ, ESSAY, FILE_UPLOAD, FORUM
  questions     String    // JSON das questões
  maxAttempts   Int       @default(3)
  aiGrading     Boolean   @default(false)
  gradingPrompt String?   // Prompt para correção IA
  dueDate       DateTime?
  points        Int       @default(100)

  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions   Submission[]
  activityQuestions ActivityQuestion[]
}

model ActivityQuestion {
  activityId String
  questionId String
  order      Int      @default(0)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([activityId, questionId])
}

model Submission {
  id            String    @id @default(cuid())
  activityId    String
  userId        String
  answers       String    // JSON das respostas
  aiFeedback    String?
  aiGrade       Float?
  finalGrade    Float?
  attempt       Int       @default(1)
  submittedAt   DateTime  @default(now())

  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ForumPost {
  id            String    @id @default(cuid())
  lessonId      String
  userId        String
  content       String
  isAI          Boolean   @default(false)
  isResolved    Boolean   @default(false)
  upvotes       Int       @default(0)
  parentId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        ForumPost?  @relation("Replies", fields: [parentId], references: [id])
  replies       ForumPost[] @relation("Replies")
}

model AIChat {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String?
  messages      String    // JSON das mensagens
  context       String?   // JSON do contexto enviado
  tokensUsed    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
}

model Progress {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String
  videoProgress Float     @default(0)
  materialsRead String    @default("[]") // JSON array de IDs
  completed     Boolean   @default(false)
  lastAccess    DateTime  @default(now())
  timeSpent     Int       @default(0)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model KnowledgeBase {
  id         String           @id @default(cuid())
  title      String
  courseId   String?
  lessonId   String?
  sourceType String           @default("manual") // manual | transcript | material
  createdAt  DateTime         @default(now())
  chunks     KnowledgeChunk[]
}

model KnowledgeChunk {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  content         String
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  // Coluna `embedding vector(384)` adicionada via SQL raw (Prisma não conhece o tipo).
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model QuestionCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
}

model Question {
  id         String            @id @default(cuid())
  categoryId String?
  category   QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type       String // MULTIPLE_CHOICE | TRUE_FALSE | ESSAY
  statement  String
  options    String? // JSON [{ text, correct }] p/ MC/TF; null p/ ESSAY
  answerKey  String? // gabarito/rubrica
  points     Int               @default(1)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  activityQuestions ActivityQuestion[]
}

// Configurações do sistema (painel admin) - não usar .env para IA
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
